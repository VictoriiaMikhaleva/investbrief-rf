{
  "name": "investbrief-rf",
  "version": "1.0.0",
  "description": "",
  "main": "analytics.js",
  "scripts": {
    "sync:core": "node scripts/sync-analytics-core.mjs",
    "test": "npm run sync:core && npm run test:analytics && npm run test:analytics-server",
    "test:analytics": "node scripts/test-analytics.mjs",
    "test:analytics-server": "node scripts/test-analytics-server.mjs",
