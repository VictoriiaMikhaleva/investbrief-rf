rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Профиль и настройки пользователя — только владелец документа
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Метаданные сторожа данных — чтение для всех, запись только Cloud Functions (Admin SDK)
    match /meta/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
